{
  "expo": {
    "name": "Local AI Lab",
    "slug": "local-ai-lab",
    "scheme": "localailab",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ph.appbuilders.localailab"
    },
    "android": {
      "package": "ph.appbuilders.localailab",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Records speech to test on-device speech recognition."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Picks a photo to test on-device image description.",
          "cameraPermission": "Takes a photo to test on-device image description."
        }
      ],
      "expo-sharing",
      "llama.rn",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
